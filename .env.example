# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=turnero
DB_USER=turnero_user
DB_PASSWORD=CambiarEsto2026

# ── App ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Seguridad ─────────────────────────────────────────────────
# Debe coincidir con el valor en la extensión Chrome
EXTENSION_SECRET=cambiar_este_secreto_en_produccion

# ── Admin (protección básica opcional) ───────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=CambiarEsto2026

# ── Edición del producto ─────────────────────────────────────
# basica = solo sonido | plus = sonido + anuncio por voz (TTS).
# La fija el instalador; el cliente NO la cambia desde el panel. Sin este valor
# se asume 'basica' (sin voz). En Plus, la voz además debe activarse desde Admin.
#
# OJO: si la instalación exige licencia (ver abajo), este valor SE IGNORA y manda
# la edición firmada dentro de licencia.lic.
EDICION=basica

# ── Candado de licencia ──────────────────────────────────────
# Deja el archivo licencia.lic como requisito para arrancar.
#
#   - Corriendo como .exe (empaquetado con pkg): SIEMPRE se exige, esté o no
#     esta variable. No hay forma de apagarlo desde el .env.
#   - Corriendo desde código (node server.js / Docker / servicio NSSM sobre
#     node.exe): NO se exige, salvo que pongas esta variable en true.
#
# Si no ponés nada y corrés desde código, el sistema funciona sin límite de
# tiempo: no es una "licencia perpetua", es que no hay licencia que revisar.
# Déjalo comentado salvo que quieras probar el candado sin empaquetar.
# LICENCIA_REQUERIDA=true
#
# Ruta alternativa del archivo de licencia. Por defecto se busca junto al
# ejecutable (.exe) o dentro de app/ (corriendo desde código).
# LICENCIA_PATH=C:\turnero\licencia.lic

# ── TTS (anuncio por voz en las pantallas TV) — solo si EDICION=plus ─
# Motor de voz: espeak (dev/Docker) | piper (prod, neuronal) | sapi (Windows) | say (macOS)
TTS_ENGINE=espeak
# Solo si TTS_ENGINE=piper (rutas dejadas por scripts/setup-tts.*):
# PIPER_BIN=vendor/tts/piper/piper
# PIPER_MODEL=vendor/tts/models/es_ES-sharvard-medium.onnx
# PIPER_SPEAKER=1   # sharvard tiene 2 voces; la 1 es la femenina elegida
# Ritmo de la voz (opcional): length_scale >1 = más lento; silencio entre frases (seg):
# PIPER_LENGTH_SCALE=1.25
# PIPER_SENTENCE_SILENCE=0.4
# Solo si TTS_ENGINE=sapi (Windows); vacío = voz por defecto del SO:
# VOZ_SAPI=Microsoft Sabina Desktop
